; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Honor and Iron 3"
config/description="Mana Seed living maps + Honor & Iron deterministic tactics"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

WeatherBus="*res://autoload/weather_bus.gd"
WindBus="*res://autoload/wind_bus.gd"
SettingsManager="*res://ui/settings_manager.gd"
MenuNavigation="*res://ui/menu_navigation.gd"
EventBus="*res://presentation/event_bus.gd"
NetworkManager="*res://core/systems/network_manager.gd"
GlobalTimeline="*res://core/state/global_timeline.gd"
SkirmishLaunch="*res://autoload/skirmish_launch.gd"

[display]

window/size/viewport_width=3840
window/size/viewport_height=1800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
