@export var id: Id = Id.NONE
@export var value: Variant = true
## Used when a factory still passes a key that is not in Id yet.
@export var override_key: String = ""


static func key_for(extra_id: Id) -> String:
	var names: PackedStringArray = Id.keys()
	if extra_id <= Id.NONE or extra_id >= names.size():
		return ""
	return String(names[extra_id]).to_lower()


static func id_for_key(key: String) -> Id:
	if key.is_empty():
		return Id.NONE
	var needle := key.to_upper()
	var names: PackedStringArray = Id.keys()
	for index: int in range(names.size()):
		if names[index] == needle:
			return index as Id
	return Id.NONE


func runtime_key() -> String:
	if not override_key.is_empty():
		return override_key
	return key_for(id)